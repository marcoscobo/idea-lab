# Copy to .env for local development. Subscription CLIs need no API key here.
# Sign in through the official CLI in the same environment that runs the server:
#   codex login                 (choose ChatGPT)
#   claude auth login           (choose your Claude subscription)
# Choose your provider in the UI Settings. You can save an OpenAI API key there.
# UI settings are stored only on this computer in .data/settings.json (mode 600).
# The key is never returned to the browser after saving or stored in localStorage.
# API-key environment variables are deliberately omitted from subscription CLI
# subprocesses. Saved API authentication is rejected by the login preflight.
# Keep all keys and native CLI login stores private.

# Optional API fallback, used until a UI key is saved or explicitly removed.
# API billing is separate from CLI subscription usage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Optional executable paths if the CLIs are not on the server PATH.
CODEX_BIN=codex
CLAUDE_BIN=claude
# Leave blank to use each CLI's default model and your account's access.
CODEX_MODEL=
CLAUDE_MODEL=

PORT=3000
# Optional location for private server settings. Default: project .data directory.
# IDEA_LAB_DATA_DIR=/absolute/private/directory
# Local default listens on your computer only. Docker sets 0.0.0.0 internally.
# HOST=127.0.0.1
